package-as: MDTRouteLibrary

# Das Datenaddon wird aus dem Paketordner herausgezogen, damit es im
# AddOns-Verzeichnis als eigenstaendiges LoadOnDemand-Addon landet.
move-folders:
  MDTRouteLibrary/MDTRouteLibrary_Data: MDTRouteLibrary_Data

# Keine externen Bibliotheken: MDTRouteLibrary nutzt ausschliesslich Blizzard-API
# (C_EncodingUtil fuer die MDT-Stringkodierung). Das haelt das Paket klein
# und vermeidet Versionskonflikte mit MDT, das eigene Libs mitbringt.
externals: {}

# Ohne diese Angabe baut der Packager die Release-Notes aus den
# Commit-Texten zusammen - inklusive aller Rumpfzeilen. Was bei CurseForge
# steht, soll hier stehen und nicht aus der Versionsgeschichte fallen.
#
# Angegeben ist bewusst RELEASE-NOTES.md und nicht CHANGELOG.md: der Packager
# nimmt diese Datei sowohl als GitHub-Release-Text als auch als
# CurseForge-Changelog. Mit der vollen Historie darin waeren beide nach ein
# paar Wochen unlesbar. tools/changelog.mjs schreibt sie vor jedem Release neu
# und legt nur den aktuellen Abschnitt hinein; die Historie bleibt in
# CHANGELOG.md im Repository.
manual-changelog:
  filename: RELEASE-NOTES.md
  markup-type: markdown

# Nicht ins Release-Paket
ignore:
  - branding
  - tools
  - data
  - .github
  - .luacheckrc
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - README.md
  # Die Historie bleibt im Repository. Ins Paket geht RELEASE-NOTES.md.
  - CHANGELOG.md
